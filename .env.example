# =============================================================================
# WinthorDocker — copie para .env e ajuste.
# Nao commite o arquivo .env.
# =============================================================================

# --- Imagem e container ---
# 19.3.0.0  = linux/amd64 (x86_64). 19.19.0.0 = linux/arm64 (Apple Silicon / Ampere).
ORACLE_IMAGE=container-registry.oracle.com/database/enterprise:19.3.0.0
ORACLE_PLATFORM=linux/amd64
ORACLE_CONTAINER_NAME=oracle-enterprise
ORACLE_PORT=1521

# --- Instancia Oracle (usadas na primeira criacao do banco) ---
ORACLE_SID=ORLCDV
ORACLE_PDB=WINT
ORACLE_PWD=S3nh4Admin01
ORACLE_EDITION=enterprise
ORACLE_CHARACTERSET=WE8MSWIN1252

# --- Recursos da instancia ---
INIT_SGA_SIZE=8192
INIT_PGA_SIZE=2048
INIT_CPU_COUNT=4
INIT_PROCESSES=900
ENABLE_ARCHIVELOG=true
ENABLE_FORCE_LOGGING=true
ENABLE_TCPS=true

# --- Schema Winthor ---
SCHEMA_DESTINO=WINTHOR
SCHEMA_PASSWORD=SU9FTA3A
SCHEMA_ORIGEM=COAGRO

# --- Tablespaces ---
TS_DADOS=TS_DADOS
TS_INDICE=TS_INDICE
TS_INITIAL_SIZE=3G
TS_NEXT_SIZE=100M

# --- Dump (impdp) ---
DUMP_DIR=/dump
DUMP_FILE_NAME=USER_FULL_WINT_COAGRO.dmp
LOG_FILE_NAME=USER_FULL_WINT_IMPORT_COAGRO.log

# --- Conexao usada pelos scripts de bootstrap ---
ORACLE_USER=system
ORACLE_HOST=localhost
ORACLE_WAIT_SECONDS=30

# --- Winthor Anywhere (WTA) ---
# Instalador Linux em assets/ (nao versionado). Origem:
# https://storage.googleapis.com/artefatos-winthor/WTA-WinThorAnywhere/linux/winthor-setup-1.9.0.zip
WTA_SETUP_ZIP=assets/winthor-setup-1.9.0.zip
WTA_CONTAINER_NAME=wta
WTA_ORACLE_HOST=oracle-db
WTA_ORACLE_PORT=1521
WTA_HTTP_PORT=8180
WTA_SSH_PORT=8101
WTA_RMI_PORT=1099
WTA_ARTEMIS_PORT=61616
WTA_LOJA=1
WTA_EMPRESA=1
# Deixe vazio para usar o IP do container. Use o IP/hostname acessivel pelos clientes Winthor.
WTA_SERVER_HOST=
